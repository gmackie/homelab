#!/usr/bin/env bash

set -euo pipefail

mount_point=/mnt/nas/homelab
nas_host=newnas.homelab.lan
nas_source="$nas_host:/tank/media/library"
attempts=${FORGEGRAPH_MEDIA_STORAGE_ATTEMPTS:-60}
delay=${FORGEGRAPH_MEDIA_STORAGE_DELAY_SECONDS:-2}

for ((attempt = 1; attempt <= attempts; attempt++)); do
    if timeout 4 getent ahostsv4 "$nas_host" >/dev/null 2>&1; then
        timeout 6 stat "$mount_point/downloads" >/dev/null 2>&1 || true
    fi

    if findmnt -rn -T "$mount_point" -S "$nas_source" -t nfs4 >/dev/null \
        && [[ -d "$mount_point/downloads" ]] \
        && [[ -d "$mount_point/movies" ]] \
        && [[ -d "$mount_point/tv" ]]; then
        exit 0
    fi

    sleep "$delay"
done

echo "newnas media storage did not become ready after $attempts attempts" >&2
exit 1
