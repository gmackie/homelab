[Unit]
Description=Replicate NAS build storage to storedge (LAB-1)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/tank/apps/minio /tank/archive

[Service]
Type=oneshot
ExecStart=/usr/local/lib/fleet-storage/backup-to-storedge.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=12h
